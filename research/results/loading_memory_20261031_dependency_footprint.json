  "procedure": "Read laya-pro installed Requires-Dist metadata with the onnx extra; evaluate markers against this interpreter and each selected extra, recursively propagate dependency extras, and revisit packages when an extra is added. Sum existing files listed by each selected distribution RECORD. Exclude laya-pro editable project bytes. For light, sum all isolated report distributions except pip, setuptools, wheel, and laya-pro-onnx. No download or new full installation.",
  "reproduction_python": "import importlib.metadata as md\nimport json\nfrom packaging.requirements import Requirement\nfrom packaging.utils import canonicalize_name\nextras={'laya-pro': {'onnx'}}\npending=['laya-pro']\nprocessed={}\nrows={}\nwhile pending:\n    name=canonicalize_name(pending.pop())\n    selected=extras.get(name,set())\n    if name in processed and selected <= processed[name]:\n        continue\n    processed[name]=set(selected)\n    dist=md.distribution(name)\n    for raw in dist.requires or []:\n        req=Requirement(raw)\n        if req.marker and not any(req.marker.evaluate({'extra': extra}) for extra in {''} | selected):\n            continue\n        dep=canonicalize_name(req.name)\n        extras.setdefault(dep,set()).update(req.extras)\n        pending.append(dep)\n    files=[dist.locate_file(p) for p in dist.files or []]\n    rows[name]={'version':dist.version,'bytes':sum(p.stat().st_size for p in files if p.is_file())}\nrows.pop('laya-pro',None)\nlight=json.load(open('research/results/loading_memory_20261031_light_package.json',encoding='utf-8'))\nsmall={k:v for k,v in light['distributions'].items() if canonicalize_name(k) not in {'pip','setuptools','wheel','laya-pro-onnx'}}\nprint(json.dumps({'full_dependency_bytes':sum(v['bytes'] for k,v in rows.items() if k!='laya-pro'),\n                  'light_dependency_bytes':sum(v['bytes'] for v in small.values()),\n                  'full_distributions':rows,'light_dependency_distributions':small},indent=2))\n",
  "reproduction_command": "python -c \"import json; exec(json.load(open('research/results/loading_memory_20261031_dependency_footprint.json', encoding='utf-8'))['reproduction_python'])\"",
